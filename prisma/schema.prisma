generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
}

model Car {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  brand           String       @default("Honda")
  price           Int
  status          String       @default("Ready Stock")
  badge           String?
  thumbnail       String
  gallery         String
  interiorGallery String?
  videoUrl        String?
  catalogUrl      String?
  description     String
  specDefinitions String?
  colors          String?
  isActive        Boolean      @default(true)
  isFeatured      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  variants        CarVariant[]
  leads           LeadLog[]
}

model CarVariant {
  id     String  @id @default(cuid())
  carId  String
  name   String
  price  Int
  specs  String?
  colors String?
  car    Car     @relation(fields: [carId], references: [id], onDelete: Cascade)
}

model Promotion {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String
  link        String?
  tag         String?  @default("PROMO")
  period      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Sales {
  id       String  @id @default(cuid())
  name     String
  photo    String
  whatsapp String
  isActive Boolean @default(true)
}

model LeadLog {
  id        String   @id @default(cuid())
  carId     String?
  salesId   String?
  type      String   @default("WHATSAPP_CLICK")
  createdAt DateTime @default(now())
  car       Car?     @relation(fields: [carId], references: [id])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String?
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  image     String
  name      String?
  text      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
